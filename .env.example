# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# Required. Generate with:  openssl rand -base64 32
JWT_SECRET=

DB_USERNAME=postgres
DB_PASSWORD=postgres

# Creates the first SysAdmin on startup (only SysAdmins can create teams and change roles)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

MAIL_FROM=taskmanager@example.com
